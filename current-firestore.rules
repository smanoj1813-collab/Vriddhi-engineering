rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function claimRole() {
      return isSignedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function claimCollege() {
      return isSignedIn() && 'collegeId' in request.auth.token
        ? request.auth.token.collegeId
        : null;
    }

    // -- Role normalisation ---------------------------------------------------
    // The same role is spelled many ways across the generations of imports this
    // database has absorbed ("Faculty", "teacher", "Head of Department",
    // "super admin", ...), so every comparison canonicalises first.
    //
    // Legacy profile-based role resolution (role taken from users/{uid} or a
    // faculty/students document) USED to live here. It is deliberately gone:
    // those documents are client-writable, so trusting them for authorization
    // lets an account that can create a document forge a role. The client
    // resolver in src/modules/auth/context/auth.ts still reads them so a person
    // can sign in; a missing claim is repaired by `syncMyIdentity` /
    // Access Control → Identity repair, not by weakening these rules.
    //
    // Budget note: rules allow at most 10 get()/exists() calls per request, and
    // a list request pays that cost per candidate document — another reason
    // identity comes from the token and never from profile reads.

    function cleanRoleValue(raw) {
      return raw is string ? raw.trim().lower() : '';
    }

    function canonicalRole(value) {
      return value == 'teacher' || value == 'teaching staff' || value == 'teaching-staff'
        || value == 'teaching_staff' || value == 'lecturer' || value == 'professor'
        || value == 'assistant professor' || value == 'associate professor'
        || value == 'instructor' || value == 'faculty member' || value == 'faculty-member'
        ? 'faculty'
        : value == 'head of department' || value == 'head-of-department'
          || value == 'head_of_department' || value == 'dept head' || value == 'department head'
          ? 'hod'
        : value == 'administrator' || value == 'admin staff' || value == 'college admin'
          ? 'admin'
        : value == 'super admin' || value == 'super-admin' || value == 'super_admin'
          || value == 'superuser' || value == 'owner'
          ? 'superadmin'
        : value == 'vice principal' || value == 'vice-principal' || value == 'vice_principal'
          ? 'principal'
        : value == 'learner' || value == 'pupil'
          ? 'student'
        : value == 'guardian'
          ? 'parent'
        : value;
    }

    // AUTHORITATIVE IDENTITY. Role for authorization decisions is taken from
    // the verified ID-token custom claim ONLY. A newly provisioned or repaired
    // account must therefore have its claims issued AND the user must sign in
    // again, because an ID token only carries claims that existed when it was
    // minted. "Login works, every page is empty / permission-denied" is this
    // one property, and it is a provisioning gap — not a data gap.
    function role() {
      let claimedRole = canonicalRole(cleanRoleValue(claimRole()));
      return claimedRole != '' ? claimedRole : null;
    }

    // Tenancy, like role, is authoritative from the claim only — never from a
    // client-writable profile document.
    function collegeId() {
      let claimedCollege = claimCollege();
      return claimedCollege != null ? claimedCollege : null;
    }

    // Role exactly as carried by the verified ID-token custom claim — never
    // derived from a (client-writable) profile document. Writes use THIS, so a
    // forged role/collegeId field on a profile doc cannot authorise anything.
    function claimedRole() {
      return canonicalRole(cleanRoleValue(claimRole()));
    }

    // A superadmin is proven only by (a) the superadmin custom claim, or
    // (b) a superadmins/{uid} document — which itself is writable solely by an
    // already-authoritative superadmin. The superadmin role is NEVER inferred
    // from a faculty/student/admin/etc. profile doc, so it cannot be spoofed.
    function isSuperadmin() {
      return isSignedIn()
        && (claimedRole() == 'superadmin'
          || exists(/databases/$(database)/documents/superadmins/$(request.auth.uid)));
    }

    // Authoritative tenanted write gate. For non-superadmins BOTH the manager
    // role and the college must come from the token claim, so a caller cannot
    // escalate or act across colleges by editing a profile document.
    function canManageCollege(data) {
      return isSuperadmin()
        || (isSignedIn()
          && claimedRole() in ['admin', 'hod', 'principal']
          && claimCollege() != null
          && claimCollege() != ''
          && 'collegeId' in data
          && data.collegeId == claimCollege());
    }

    // `employeeStatus` is stamped by the employeeAccess callables: a suspended
    // Vriddhi employee keeps the role in `users/{uid}` (so their account still
    // resolves) but must lose every staff grant immediately. The membership
    // test matters — a token without the claim is every other role, and the
    // rules DSL does not tolerate reading a key the token does not carry.
    function employeeSuspended() {
      return 'employeeStatus' in request.auth.token
        && request.auth.token.employeeStatus == 'suspended';
    }

    function isStaff() {
      // `employee` is a Vriddhi platform employee: not a member of any one
      // institution, but scoped to the collegeId claim of the college they
      // are currently working in, so every collegeId() comparison below
      // still holds.
      return isSignedIn()
        && !employeeSuspended()
        && role() in ['superadmin', 'admin', 'principal', 'hod', 'faculty', 'mentor', 'employee'];
    }

    function isCollegeStaff() {
      return isStaff() && (isSuperadmin() || collegeId() != null);
    }

    // OPERAND ORDER IS LOAD-BEARING HERE. A list query evaluates its rule once
    // per candidate document, and Firestore allows at most 10 document accesses
    // (get()/exists()) per request — exceeding it denies the WHOLE query, which
    // surfaces to the client as a bare "Missing or insufficient permissions".
    //
    // isSuperadmin() falls through to exists(superadmins/{uid}) for anyone who
    // is not a claim-superadmin, so leading with it charged one document access
    // per row on every sameCollege() caller. A college with more than ~10
    // students then blew the budget and the entire query was refused — even
    // though the rule's boolean outcome was "allow" for every single document.
    //
    // The claim-derived tenancy check costs nothing, so evaluate it first and let
    // || short-circuit before isSuperadmin() can spend anything. isSuperadmin()
    // still runs, and still grants, for callers that genuinely fail the cheap
    // check. Purely a reordering of || operands: no condition was added, removed
    // or weakened, and the result is identical for every input.
    function sameCollege(data) {
      // A suspended employee keeps no college scope even if a stale token still
      // carries one: the claim branch refuses outright, so no same-college read
      // survives suspension. Other roles have no employeeStatus claim.
      return (!employeeSuspended()
          && collegeId() != null && 'collegeId' in data && data.collegeId == collegeId())
        || isSuperadmin();
    }

    // -- College office roles -------------------------------------------------
    // `accounts` (finance office) and `operations` (library, inventory,
    // stores) are NOT staff in the academic sense (isStaff): they never read
    // attendance, marks or papers. They reach the student/faculty directory
    // (to bill and to lend) and their own modules only. HODs / department
    // admins hold no finance access; the principal oversees everything.
    // Mirrors src/modules/auth/permissions.ts.
    function isOffice() {
      return isSignedIn() && role() in ['accounts', 'operations'] && collegeId() != null;
    }
    function inCollege(cid) {
      return isSignedIn() && collegeId() == cid;
    }
    function isFinance(cid) {
      return isSuperadmin() || (role() in ['principal', 'accounts'] && collegeId() == cid);
    }
    function isOps(cid) {
      return isSuperadmin() || (role() in ['principal', 'operations'] && collegeId() == cid);
    }
    // Back office incl. department heads (raise purchase requests, see vendors).
    function isBackOffice(cid) {
      return isSuperadmin()
        || (role() in ['principal', 'accounts', 'operations', 'admin', 'hod'] && collegeId() == cid);
    }
    // Field-tenanted variant for legacy top-level finance collections.
    function isFinanceData(data) {
      return isSuperadmin() || (role() in ['principal', 'accounts'] && sameCollege(data));
    }

    // -- Department scoping (admin ≡ department HOD) --------------------------
    // The department tag on the ID-token custom claim. Absent/empty claim ⇒
    // '' ⇒ no narrowing, exactly like the tolerant client filter in
    // src/shared/utils/departmentScope.ts.
    function claimDepartment() {
      return isSignedIn() && 'department' in request.auth.token
          && request.auth.token.department is string
        ? request.auth.token.department.trim().lower()
        : '';
    }

    // TRUE when the caller may point-read `data`. Only the admin/hod
    // (department-head) identities are narrowed, and only when BOTH sides are
    // tagged: no claim ⇒ college-wide; document without a usable department
    // tag (or department 'All' — college-wide batches) ⇒ visible; otherwise a
    // case-insensitive match. Deliberately NOT applied to `list` statements:
    // a list rule that reads resource.data denies the whole query unless every
    // candidate row satisfies it, and current client queries are scoped to
    // collegeId only with client-side department filtering (see
    // shared/utils/departmentScope). Row-level list enforcement is a follow-up
    // that needs department predicates in the queries plus the backfill.
    function deptScoped(data) {
      return !(claimedRole() in ['admin', 'hod'])
        || claimDepartment() == ''
        || !('department' in data)
        || !(data.department is string)
        || data.department.trim().lower() in ['', 'all']
        || data.department.trim().lower() == claimDepartment();
    }

    // -- Shared rule functions (1000-expression budget) ----------------------
    // The whole file shares one 1000-expression budget; every helper below
    // replaces an inlined 4-6 expression pattern at each use site. Keep them
    // EXACTLY equivalent to the patterns they replaced — the rules tests pin
    // the behaviour. `tenantWrite` == `isSuperadmin() || (isCollegeStaff() &&
    // sameCollege(data))`; `collegePathWrite` is the same idea where the
    // /colleges/{collegeId}/... path, not a field, is the tenancy.
    function tenantWrite(data) {
      return isSuperadmin() || (isCollegeStaff() && sameCollege(data));
    }

    function collegePathWrite(pathCollege) {
      return isSuperadmin() || (isCollegeStaff() && collegeId() == pathCollege);
    }

    // Curriculum reference data is readable by any college staff member for
    // their own college, plus the unassigned (collegeId-less) rows a
    // superadmin keeps in progress. get AND list share this so a list can
    // never be looser than a get — that mismatch was the cross-college leak.
    function canReadCurriculum(data) {
      return isSignedIn()
        && (isSuperadmin() || (isStaff() && (sameCollege(data) || !('collegeId' in data))));
    }

    // The faculty member a curriculum-related row names as owner. Used by
    // facultyTopics (the planner ledger) and curriculumFacultyMappings
    // (tenancy on a legacy row may be absent, so ownership proves access).
    function isAssignedFaculty(data) {
      return isSignedIn() && 'facultyId' in data && data.facultyId == request.auth.uid;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsStudentProfile(studentId, studentData) {
      return isSignedIn()
        && (
          ('userId' in studentData && studentData.userId == request.auth.uid)
          || ('uid' in studentData && studentData.uid == request.auth.uid)
          || studentId == request.auth.uid
        );
    }

    // Tenant of a student profile document, used where the accessed document
    // itself carries no collegeId (for example fees/{studentId}).
    function studentCollegeId(studentId) {
      return !isSignedIn() || studentId == null ? null
        : !exists(/databases/$(database)/documents/students/$(studentId)) ? null
        : 'collegeId' in get(/databases/$(database)/documents/students/$(studentId)).data
          ? get(/databases/$(database)/documents/students/$(studentId)).data.collegeId
        : null;
    }

    // True when the signed-in user is the addressee of a notification.
    function isRecipient(data) {
      return isSignedIn() && data != null
        && (('userId' in data && data.userId == request.auth.uid)
          || ('studentId' in data
            && (data.studentId == request.auth.uid || ownsStudentId(data.studentId))));
    }

    // assessmentQuestions inherit their tenancy from the parent test document.
    function scheduledTestCollegeId(testId) {
      return !isSignedIn() || testId == null ? null
        : !exists(/databases/$(database)/documents/scheduledTests/$(testId)) ? null
        : 'collegeId' in get(/databases/$(database)/documents/scheduledTests/$(testId)).data
          ? get(/databases/$(database)/documents/scheduledTests/$(testId)).data.collegeId
        : null;
    }

    // Which student document this account vouches for, read from the users/{uid}
    // pointer that the identity repair writes. A query gets ONE document read for
    // the whole request, and Firestore caps a request at 10 get()/exists() calls
    // shared across every candidate document — a per-row lookup here is how a
    // 30-row attendance query turns into "Missing or insufficient permissions".
    function myStudentDocId() {
      let pointer = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'studentDocId' in pointer ? pointer.studentDocId : null;
    }

    function ownsStudentId(studentId) {
      return isSignedIn()
        && studentId != null
        && (
          studentId == request.auth.uid
          || myStudentDocId() == studentId
          || (exists(/databases/$(database)/documents/students/$(studentId))
            && (('userId' in get(/databases/$(database)/documents/students/$(studentId)).data
              && get(/databases/$(database)/documents/students/$(studentId)).data.userId == request.auth.uid)
            || ('uid' in get(/databases/$(database)/documents/students/$(studentId)).data
              && get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid)))
        );
    }

    function immutableUserFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.collegeId == resource.data.collegeId;
    }

    // Mirrors SECRET_PROFILE_FIELDS in functions/src/identityShared.ts: the
    // write that provisions a person also deletes any of these that an earlier
    // importer left behind, and this rule stops a new one from being written.
    // FieldValue.delete() in an update removes the key from
    // request.resource.data, so the cleanup path is not blocked by it.
    function noPasswordField() {
      let d = request.resource.data;
      return !('password' in d) && !('passwordHash' in d) && !('passwordhash' in d)
        && !('tempPassword' in d) && !('temporaryPassword' in d) && !('defaultPassword' in d)
        && !('pwd' in d) && !('plainPassword' in d);
    }

    // A non-admin profile collection must never be used to smuggle a
    // privileged role. Only low-privilege roles may appear as a role field on
    // student/faculty/hod/mentor documents.
    function noPrivilegedRole(data) {
      return !('role' in data)
        || cleanRoleValue(data.role) in ['student', 'faculty', 'hod', 'mentor', 'parent'];
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId)
        || isSuperadmin()
        || (isStaff() && sameCollege(resource.data));
      allow create: if isSuperadmin()
        && userId == request.resource.data.uid
        && request.resource.data.role in
          ['superadmin', 'admin', 'principal', 'hod', 'mentor', 'faculty', 'student', 'parent', 'employee']
        && noPasswordField();
      allow update: if isOwner(userId)
        && immutableUserFields()
        && noPasswordField()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'collegeId', 'uid', 'permissions', 'createdBy']);
      allow delete: if isSuperadmin();
    }

    match /students/{id} {
      allow get: if ownsStudentProfile(id, resource.data)
        || (isSignedIn() && 'email' in request.auth.token
          && resource.data.email == request.auth.token.email)
        || isSuperadmin()
        || (isStaff() && sameCollege(resource.data) && deptScoped(resource.data))
        || (isOffice() && sameCollege(resource.data));
      // A list is authorised per candidate document, so a query the client
      // constrains to the caller's own row (where('userId','==',auth.uid),
      // where('uid',…), or documentId) satisfies ownsStudentProfile and is
      // allowed, while an unbounded sweep still fails. Without this line the
      // student dashboard cannot resolve its own profile and reports "no
      // student record" for a correctly provisioned account.
      //
      // The cheap claim-only tests are deliberately tested FIRST. isSuperadmin()
      // ends in exists(superadmins/{uid}), so leading with it charged one
      // document access per candidate row; the Fee Management desk queries the
      // whole college roster, so it ran far past the 10-access request budget
      // and Firestore refused the entire query. The office/tenancy predicate is
      // satisfied from the ID token alone at zero cost, and || short-circuits
      // there. Identical boolean result for every input — operands reordered
      // only, so no caller gains access that did not already pass the same test.
      allow list: if isSignedIn() && ((isOffice() && sameCollege(resource.data))
        || isStaff() || isSuperadmin()
        || ownsStudentProfile(id, resource.data));
      allow create: if canManageCollege(request.resource.data)
        && noPrivilegedRole(request.resource.data)
        && noPasswordField();
      allow update: if canManageCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId
        && (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId)
        && noPrivilegedRole(request.resource.data)
        && noPasswordField();
      allow delete: if canManageCollege(resource.data);
    }

    match /faculty/{id} {
      allow get: if isSignedIn() && (isOwner(id)
        || isSuperadmin()
        || (sameCollege(resource.data) && deptScoped(resource.data))
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      // Same reasoning as students: sign-in identity resolution queries faculty
      // by uid/email. A staff-only list rule locks out precisely the accounts
      // whose claim has not been issued yet, so the self-scoped alternatives
      // are allowed here.
      allow list: if isSignedIn() && (isSuperadmin() || isStaff()
        || (isOffice() && sameCollege(resource.data))
        || isOwner(id)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow create: if (canManageCollege(request.resource.data)
          || (claimedRole() == 'employee' && isStaff() && id == request.auth.uid
            && request.resource.data.collegeId == claimCollege()))
        && noPrivilegedRole(request.resource.data)
        && noPasswordField();
      allow update: if (canManageCollege(resource.data)
          || (claimedRole() == 'employee' && isStaff() && id == request.auth.uid
            && request.resource.data.collegeId == claimCollege()))
        && request.resource.data.collegeId == resource.data.collegeId
        && ('uid' in resource.data ? request.resource.data.uid == resource.data.uid : true)
        && noPrivilegedRole(request.resource.data)
        && noPasswordField();
      allow delete: if canManageCollege(resource.data);
    }

    match /admins/{id} {
      allow read: if isSignedIn() && (isOwner(id)
        || isSuperadmin()
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      // Older importers stored a plaintext `password` on staff profiles. These
      // collections are readable by other staff of the college, so a credential
      // there is a leak — and the reason "open Firestore and read the password"
      // became the workflow. No profile document may carry one.
      allow create, update: if isSuperadmin() && noPasswordField();
      allow delete: if isSuperadmin();
    }

    match /hods/{id} {
      allow read: if isSignedIn() && (isOwner(id)
        || isSuperadmin()
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow create: if canManageCollege(request.resource.data) && noPrivilegedRole(request.resource.data) && noPasswordField();
      allow update, delete: if canManageCollege(resource.data) && noPasswordField();
    }

    match /mentors/{id} {
      allow read: if isSignedIn() && (isOwner(id)
        || isSuperadmin()
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow create: if canManageCollege(request.resource.data) && noPrivilegedRole(request.resource.data) && noPasswordField();
      allow update, delete: if canManageCollege(resource.data) && noPasswordField();
    }

    match /superadmins/{id} {
      allow read: if isSuperadmin()
        || isOwner(id)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email);
      allow write: if isSuperadmin() && noPasswordField();
    }

    match /universities/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin();
    }

    match /colleges/{collegeId} {
      allow read: if isSignedIn() && (isSuperadmin() || collegeId() == collegeId);
      // System Management can pause onboarding at the security boundary, not
      // only in the Create College UI. Missing config preserves the historical
      // default of allowing onboarding until a superadmin explicitly disables it.
      allow create: if isSuperadmin()
        && (!exists(/databases/$(database)/documents/systemConfig/app)
          || get(/databases/$(database)/documents/systemConfig/app).data.allowCollegeOnboarding == true);
      allow update, delete: if isSuperadmin();

      match /students/{id} {
        allow get: if ownsStudentProfile(id, resource.data)
          || isSuperadmin()
          || (isStaff() && collegeId() == collegeId && deptScoped(resource.data))
          || (isOffice() && collegeId() == collegeId);
        // `list` may reference resource.data because rules are evaluated per
        // candidate document; the client's query has to be constrained to rows
        // that satisfy the rule. The student branch therefore only admits a
        // query scoped to the caller's own record (studentDocId / userId),
        // which is what studentRecordResolver issues.
        allow list: if isSignedIn() && (isSuperadmin()
          || ((isStaff() || isOffice()) && collegeId() == collegeId)
          || ownsStudentProfile(id, resource.data));
        allow create, update: if (isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId)) && noPasswordField();
        allow delete: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      // Reads inside a college path use the PATH as the tenant boundary, which
      // is cheaper and stricter than reading collegeId off each document.
      // (Rules are evaluated per candidate document for a list, so a rule may
      // reference resource.data — but the client's query must be constrained to
      // rows that satisfy it, otherwise the whole request fails. That is why the
      // app's queries always carry the collegeId/documentId predicate.)
      match /config/{docId} {
        // config/branding is the college letterhead (name, address, receipt
        // footer) that students and faculty need to render their own fee
        // receipts / payslips; every other config doc stays staff-only.
        // config/library (loan rules) is likewise shown to borrowers; the
        // codingLab assignment flag is readable only by students of its college
        // so the BCA navigation can fail closed without a public settings API.
        // config/modules (optional-module toggles, e.g. Assignments) is likewise
        // readable by the college's own students so navigation can hide a module
        // the college switched off.
        allow get: if isSignedIn() && (isSuperadmin()
          || (docId == 'courses' && role() in ['admin', 'hod', 'principal', 'student'] && collegeId() == collegeId)
          || (docId in ['codingLab', 'modules'] && role() == 'student' && collegeId() == collegeId)
          || (docId != 'courses' && docId != 'codingLab' && isStaff() && collegeId() == collegeId)
          || (isOffice() && collegeId() == collegeId)
          || (docId in ['branding', 'library', 'nodues'] && collegeId() == collegeId));
        allow list: if isSignedIn() && (isSuperadmin()
          || ((isStaff() || isOffice()) && collegeId() == collegeId));
        // `config/access` is legacy; payroll roles no longer depend on it.
        // Finance policy is managed by accounts. The principal may still update
        // other finance settings, but cannot create/update/delete the payroll
        // calculation map from the UI or a direct client write.
        allow write: if docId == 'access'
          ? (isSuperadmin() || (role() == 'principal' && collegeId() == collegeId))
          : docId in ['courses', 'codingLab']
            // Course and Coding Lab assignments are PLATFORM access controls.
            // Students can read their own college's setting, but only the
            // platform superadmin may change it.
            ? isSuperadmin()
          : docId in ['branding', 'tally']
            ? isFinance(collegeId)
          : docId == 'finance'
            ? false
            : docId == 'procurement'
              // purchase workflow (ops) + TDS sections (accounts)
              ? (isOps(collegeId) || isFinance(collegeId))
            : docId in ['library', 'inventory', 'nodues']
              ? isOps(collegeId)
              : (isSuperadmin() || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId));

        // The principal may initialize general finance settings without adding
        // payroll policy. Accounts owns payroll settings after the handoff.
        allow create: if docId == 'finance' && isFinance(collegeId)
          && (isSuperadmin() || role() != 'principal' || !('payroll' in request.resource.data));
        allow update: if docId == 'finance' && isFinance(collegeId)
          && (isSuperadmin() || role() == 'accounts'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['payroll']));
        allow delete: if docId == 'finance'
          && (isSuperadmin() || (role() == 'accounts' && collegeId() == collegeId));
      }

      // Learner progress is tenant-path scoped. Students may read/write their
      // own record only; college staff can report on records in their college.
      match /courseProgress/{progressId} {
        allow get: if isSignedIn() && (isSuperadmin()
          || (role() in ['admin', 'principal', 'hod'] && collegeId() == collegeId)
          || (role() == 'student' && collegeId() == collegeId
            && resource.data.uid == request.auth.uid));
        allow list: if isSignedIn() && (isSuperadmin()
          || (role() in ['admin', 'principal', 'hod'] && collegeId() == collegeId)
          || (role() == 'student' && collegeId() == collegeId
            && resource.data.uid == request.auth.uid));
        allow create: if isSignedIn() && role() == 'student'
          && collegeId() == collegeId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.collegeId == collegeId
          && request.resource.data.courseId is string
          && progressId == request.auth.uid + '__' + request.resource.data.courseId
          && request.resource.data.completed is map
          && request.resource.data.quiz is map;
        allow update: if isSignedIn() && role() == 'student'
          && collegeId() == collegeId
          && resource.data.uid == request.auth.uid
          && resource.data.collegeId == collegeId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.collegeId == collegeId
          && request.resource.data.courseId == resource.data.courseId
          && progressId == request.auth.uid + '__' + request.resource.data.courseId
          && request.resource.data.completed is map
          && request.resource.data.quiz is map;
        allow delete: if false;
      }

      match /announcements/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow list: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId);
      }

      // -- Legacy dashboard collections ---------------------------------------
      // These per-college collections feed the admin, principal, and faculty
      // dashboards (see src/modules/admin/api/dashboardApi.ts,
      // src/modules/admin/api/feeApi.ts, src/modules/faculty/pages/
      // FacultyDashboard.tsx). They pre-date the collegeId hygiene work, so
      // individual documents cannot be trusted to carry a collegeId field -
      // the collection path itself is the tenant boundary.

      match /schedules/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /attendance/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if collegePathWrite(collegeId);
      }

      match /attendanceRecords/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if collegePathWrite(collegeId);
      }

      match /assessments/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if collegePathWrite(collegeId);
      }

      match /scores/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if collegePathWrite(collegeId);
      }

      match /activities/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /milestones/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff());
        allow list: if isSignedIn() && (isSuperadmin() || isStaff());
        allow write: if collegePathWrite(collegeId);
      }

      match /feeStructures/{docId} {
        // A student may read the fee structures of their own college: a published
        // structure carries no studentId and is shared reference data, while one
        // addressed to a student is theirs alone.
        allow get, list: if isSignedIn() && (isFinance(collegeId)
          || (role() == 'student' && collegeId() == collegeId
            && (!('studentId' in resource.data) || ownsStudentId(resource.data.studentId))));
        allow write: if isFinance(collegeId);
      }

      match /feePayments/{docId} {
        // Payments are personal transactions, so a student is admitted only to
        // their own rows — never to the college ledger the admin page reads.
        allow get, list: if isSignedIn() && (isFinance(collegeId)
          || (role() == 'student' && collegeId() == collegeId
            && 'studentId' in resource.data && ownsStudentId(resource.data.studentId)));
        allow write: if isFinance(collegeId);
        // The library desk may post an (unpaid) library fine onto a student's
        // fee account so the accounts team collects it like any other due.
        allow create: if role() == 'operations' && collegeId() == collegeId
          && request.resource.data.category == 'library'
          && request.resource.data.paidAmount == 0
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;

        // The ledger entry is the current balance; this append-only trail makes
        // receipts and waivers auditable without exposing another student's
        // payment history.
        match /transactions/{transactionId} {
          allow get, list: if isSignedIn() && (isFinance(collegeId)
            || (role() == 'student'
              && 'studentId' in get(/databases/$(database)/documents/colleges/$(collegeId)/feePayments/$(docId)).data
              && ownsStudentId(get(/databases/$(database)/documents/colleges/$(collegeId)/feePayments/$(docId)).data.studentId)));
          // Finance staff record a collected payment directly; a student may only
          // FILE their own proof — an append-only, unverified submission that
          // credits nothing until an admin approves it via verifyPaymentProof.
          allow create: if isFinance(collegeId)
            || (isSignedIn() && role() == 'student' && collegeId() == collegeId
              && 'studentId' in get(/databases/$(database)/documents/colleges/$(collegeId)/feePayments/$(docId)).data
              && ownsStudentId(get(/databases/$(database)/documents/colleges/$(collegeId)/feePayments/$(docId)).data.studentId)
              && request.resource.data.type == 'payment'
              && request.resource.data.submissionStatus == 'pending_verification'
              && request.resource.data.amount is number
              && request.resource.data.amount > 0);
          // Verification only ever stamps review metadata onto an existing
          // submission; it cannot rewrite the amount or the submission type.
          allow update: if isFinance(collegeId)
            && resource.data.submissionStatus == 'pending_verification'
            && request.resource.data.submissionStatus in ['verified', 'rejected']
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.type == resource.data.type
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['submissionStatus', 'verifiedBy', 'verifiedAt', 'receiptNo', 'rejectionReason', 'updatedAt']);
          allow delete: if isFinance(collegeId);
        }
      }

      // Online-payment gateway orders are created and credited entirely by the
      // Cloud Function via the Admin SDK, which bypasses these rules — clients
      // never write here. Read is observability only for finance staff.
      match /paymentOrders/{docId} {
        allow get, list: if isFinance(collegeId);
        allow write: if false;
      }

      // -- Faculty pay ledgers (Guest Faculty Billing + Payroll) --------------
      // Payroll is a segregated workflow: accounts manages structures, drafts
      // and payment processing; the principal reads submitted snapshots and may
      // approve or request changes, but cannot edit or pay them.
      function isPayrollAccounts(cid) {
        return isSuperadmin() || (collegeId() == cid && role() == 'accounts');
      }
      function isPayrollApprover(cid) {
        return isSuperadmin() || (collegeId() == cid && role() == 'principal');
      }
      function isGuestBillManager(cid) {
        return isFinance(cid);
      }
      function ownsPayRow(cid) {
        return isSignedIn() && collegeId() == cid && resource.data.facultyUid == request.auth.uid;
      }
      function ownsReleasedPayslip(cid) {
        return isSignedIn() && collegeId() == cid
          && resource.data.facultyUid == request.auth.uid
          && resource.data.status in ['approved', 'paid'];
      }

      match /guestBills/{docId} {
        allow get, list: if isGuestBillManager(collegeId) || ownsPayRow(collegeId);
        allow write: if isGuestBillManager(collegeId);
      }

      match /salaryStructures/{docId} {
        // Salary structures contain bank and tax identifiers, so only the
        // accounts team manages them; faculty may still read their own row.
        allow get, list: if isPayrollAccounts(collegeId) || ownsPayRow(collegeId);
        allow create, update, delete: if isPayrollAccounts(collegeId);
      }

      match /payslips/{docId} {
        function accountPayslipUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          let statusOnly = changed.hasOnly(['status', 'updatedAt', 'history']);
          return (
            (resource.data.status == 'draft' && request.resource.data.status == 'draft'
              && request.resource.data.month == resource.data.month
              && request.resource.data.facultyProfileId == resource.data.facultyProfileId
              && request.resource.data.facultyUid == resource.data.facultyUid
              && request.resource.data.payslipNo == resource.data.payslipNo
              && changed.hasOnly(['name', 'staffCode', 'department', 'designation', 'employmentType',
                'joiningDate', 'pan', 'uan', 'bankName', 'accountNo', 'basic', 'lopDays', 'adjustments',
                'daysInPeriod', 'paidDays', 'earnings', 'deductions', 'gross', 'totalDeductions', 'net',
                'updatedAt', 'history']))
            || (resource.data.status == 'draft' && request.resource.data.status == 'pending_approval'
              && request.resource.data.submittedBy is string
              && request.resource.data.submittedByUid == request.auth.uid
              && request.resource.data.submittedAt is timestamp
              && !('reviewedBy' in request.resource.data)
              && !('reviewedByUid' in request.resource.data)
              && !('reviewedAt' in request.resource.data)
              && !('reviewDecision' in request.resource.data)
              && !('reviewNote' in request.resource.data)
              && !('approvedBy' in request.resource.data)
              && !('approvedByUid' in request.resource.data)
              && !('approvedAt' in request.resource.data)
              && changed.hasOnly(['status', 'submittedBy', 'submittedByUid', 'submittedAt',
                'reviewedBy', 'reviewedByUid', 'reviewedAt', 'reviewDecision', 'reviewNote',
                'approvedBy', 'approvedByUid', 'approvedAt', 'updatedAt', 'history']))
            || (resource.data.status == 'pending_approval' && request.resource.data.status == 'draft'
              && request.resource.data.withdrawnBy is string
              && request.resource.data.withdrawnByUid == request.auth.uid
              && request.resource.data.withdrawnAt is timestamp
              && changed.hasOnly(['status', 'withdrawnBy', 'withdrawnByUid', 'withdrawnAt', 'updatedAt', 'history']))
            || (resource.data.status == 'approved' && request.resource.data.status == 'paid'
              && request.resource.data.paidOn is string
              && request.resource.data.markedPaidBy is string
              && request.resource.data.markedPaidByUid == request.auth.uid
              && changed.hasOnly(['status', 'paidOn', 'paymentRef', 'markedPaidBy', 'markedPaidByUid', 'updatedAt', 'history']))
            || (resource.data.status == 'draft' && request.resource.data.status == 'cancelled' && statusOnly)
            || (resource.data.status == 'cancelled' && request.resource.data.status == 'draft' && statusOnly)
          );
        }

        function principalPayslipReview() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return resource.data.status == 'pending_approval'
            && request.resource.data.status in ['approved', 'draft']
            && request.resource.data.reviewedBy is string
            && request.resource.data.reviewedByUid == request.auth.uid
            && request.resource.data.reviewedAt is timestamp
            && ((request.resource.data.status == 'approved'
                && request.resource.data.reviewDecision == 'approved'
                && request.resource.data.approvedBy is string
                && request.resource.data.approvedByUid == request.auth.uid
                && request.resource.data.approvedAt is timestamp)
              || (request.resource.data.status == 'draft'
                && request.resource.data.reviewDecision == 'changes_requested'
                && request.resource.data.reviewNote is string
                && request.resource.data.reviewNote.size() > 0))
            && changed.hasOnly(['status', 'reviewedBy', 'reviewedByUid', 'reviewedAt', 'reviewDecision',
              'reviewNote', 'approvedBy', 'approvedByUid', 'approvedAt', 'updatedAt', 'history']);
        }

        // Principals see only submissions and released payroll. The client query
        // carries the same status filter, as Firestore requires for list rules.
        allow get, list: if isPayrollAccounts(collegeId)
          || (isPayrollApprover(collegeId) && resource.data.status in ['pending_approval', 'approved', 'paid'])
          || ownsReleasedPayslip(collegeId);
        allow create: if isPayrollAccounts(collegeId)
          && request.resource.data.status == 'draft'
          && request.resource.data.month is string
          && request.resource.data.facultyUid is string;
        allow update: if (isPayrollAccounts(collegeId) && accountPayslipUpdate())
          || (isPayrollApprover(collegeId) && principalPayslipReview());
        allow delete: if isPayrollAccounts(collegeId)
          && resource.data.status in ['draft', 'cancelled'];
      }
      match /salaryCertificates/{docId} {
        allow get, list: if isPayrollAccounts(collegeId) || ownsPayRow(collegeId);
        allow create, update, delete: if isPayrollAccounts(collegeId);
      }

      // University exam-fee challans (Karnataka-pattern 3-copy bank slips:
      // src/modules/admin/pages/ChallanManagement.tsx,
      // src/modules/student/pages/StudentChallans.tsx).
      //
      // This block is the reason the student portal's "My Challans" screen was
      // empty. The collection had no rule, so the catch-all at the bottom of
      // this file denied EVERY read — the admin screen logged permission-denied
      // into the console and the student page rendered "No challans yet" even
      // for rows that had been generated for them.
      //
      // A challan is a personal financial document (the university's bank
      // account, the student's reg no, the exact amount owed), so a student is
      // admitted only to the rows that name them — never to the college-wide
      // list the finance office reads. Ownership is resolved the same way the
      // fee ledger resolves it, through `studentId` matching the caller's own
      // student record; the client query therefore carries the `studentId`
      // predicate, because a LIST an unbounded rule must not be attempted.
      match /challans/{docId} {
        allow get, list: if isSignedIn() && (isFinance(collegeId)
          || (role() == 'student' && collegeId() == collegeId
            && 'studentId' in resource.data && ownsStudentId(resource.data.studentId)));
        // Generation stamps the student, the amount and a due date; the number
        // is what a bank is asked to collect, so it may not be negative and a
        // fresh challan always starts life as `generated`.
        allow create: if isFinance(collegeId)
          && request.resource.data.studentId is string
          && request.resource.data.studentId != ''
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.status == 'generated';
        // Verification against the bank reference is a finance-office action.
        // A student may never move their own challan to `verified`, and nobody
        // edits the amount or the addressee after issue — those two fields are
        // what a stamped slip is reconciled against.
        allow update: if isFinance(collegeId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.amount == resource.data.amount;
        // …but the student owns one transition: declaring that they paid at the
        // counter. Exactly the fields of that declaration may change, only from
        // a status that is still awaiting it, and only ever to `paid_at_bank`.
        // There is no document upload in this flow — the stamped copy is handed
        // in at the office, and storage.rules therefore has no challan path.
        allow update: if isSignedIn() && role() == 'student' && collegeId() == collegeId
          && 'studentId' in resource.data && ownsStudentId(resource.data.studentId)
          && resource.data.status in ['generated', 'rejected', 'expired']
          && request.resource.data.status == 'paid_at_bank'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'bankReferenceNo', 'studentRemarks', 'paidAt', 'updatedAt'])
          && request.resource.data.bankReferenceNo is string
          && request.resource.data.bankReferenceNo.matches('^[A-Za-z0-9/-]{6,40}$')
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.studentId == resource.data.studentId;
        allow delete: if isFinance(collegeId);
      }

      // -- Library (operations team) -------------------------------------------
      // Titles/copies are the college catalogue: every member of the college
      // may browse. Loans, reservations and fines are personal: a borrower
      // sees only rows naming them (memberUid == uid); the desk sees all.
      // A borrower's own row: matched on the auth uid stamped at issue, or —
      // for students whose record predates auth linking — on the student
      // record id (same resolution as fee ledger rows).
      function ownsMemberRow(cid) {
        return inCollege(cid) && (resource.data.memberUid == request.auth.uid
          || (role() == 'student' && 'studentId' in resource.data
            && resource.data.studentId is string && resource.data.studentId != ''
            && ownsStudentId(resource.data.studentId)));
      }
      match /libraryTitles/{docId} {
        allow get, list: if isSuperadmin() || inCollege(collegeId);
        allow write: if isOps(collegeId);
      }
      match /libraryCopies/{docId} {
        allow get, list: if isSuperadmin() || inCollege(collegeId);
        allow write: if isOps(collegeId);
      }
      match /libraryLoans/{docId} {
        allow get, list: if isOps(collegeId) || isFinance(collegeId) || ownsMemberRow(collegeId);
        allow write: if isOps(collegeId);
        // A borrower may only ASK for a renewal; the desk grants it.
        allow update: if ownsMemberRow(collegeId) && resource.data.status == 'issued'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renewRequestedAt', 'updatedAt']);
      }
      match /libraryReservations/{docId} {
        allow get, list: if isOps(collegeId) || ownsMemberRow(collegeId);
        allow create: if isOps(collegeId) || (inCollege(collegeId)
          && request.resource.data.memberUid == request.auth.uid
          && request.resource.data.status == 'waiting');
        allow update: if isOps(collegeId) || (ownsMemberRow(collegeId)
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
        allow delete: if isOps(collegeId);
      }
      // Fines are shared by both offices: the desk assesses, collects at the
      // counter or posts to the fee account; only finance may WAIVE.
      match /libraryFines/{docId} {
        allow get, list: if isOps(collegeId) || isFinance(collegeId) || ownsMemberRow(collegeId);
        allow create: if isOps(collegeId) || isFinance(collegeId);
        allow update: if isFinance(collegeId)
          || (isOps(collegeId) && request.resource.data.status != 'waived');
        allow delete: if isFinance(collegeId);
      }
      match /libraryVisits/{docId} {
        allow read, write: if isOps(collegeId);
      }
      match /libraryStockChecks/{docId} {
        allow read, write: if isOps(collegeId);
      }

      // -- Inventory, procurement, vendor bills --------------------------------
      match /assets/{docId} {
        allow read: if isBackOffice(collegeId);
        allow write: if isOps(collegeId);
      }
      match /inventoryItems/{docId} {
        allow read: if isBackOffice(collegeId);
        allow write: if isOps(collegeId);
      }
      match /stockMovements/{docId} {
        allow read: if isBackOffice(collegeId);
        allow write: if isOps(collegeId);
      }
      match /vendors/{docId} {
        allow read: if isBackOffice(collegeId);
        allow write: if isOps(collegeId) || isFinance(collegeId);
      }
      // Departments raise requests in their own name; approvals follow the
      // college chain (config/procurement), enforced by the page.
      match /purchaseRequests/{docId} {
        allow read: if isBackOffice(collegeId);
        allow create: if isBackOffice(collegeId)
          && request.resource.data.requestedBy.uid == request.auth.uid
          && request.resource.data.status == 'submitted';
        allow update: if isBackOffice(collegeId);
        allow delete: if isOps(collegeId);
      }
      match /purchaseOrders/{docId} {
        allow read: if isBackOffice(collegeId);
        allow write: if isOps(collegeId);
      }
      match /goodsReceipts/{docId} {
        allow read: if isBackOffice(collegeId);
        allow write: if isOps(collegeId);
      }
      match /vendorBills/{docId} {
        allow read, create: if isFinance(collegeId) || isOps(collegeId);
        allow update, delete: if isFinance(collegeId);
      }
      // No-dues clearance: each office clears its own section; the student
      // may follow their own request.
      match /noDues/{docId} {
        allow read: if isBackOffice(collegeId)
          || (inCollege(collegeId) && resource.data.studentUid == request.auth.uid);
        allow create: if isFinance(collegeId) || isOps(collegeId)
          // a student may APPLY (empty checklist — offices fill their sections)
          || (role() == 'student' && inCollege(collegeId)
            && request.resource.data.studentUid == request.auth.uid
            && request.resource.data.status == 'open'
            && request.resource.data.sections.size() == 0);
        // Department heads clear their department's section; the page limits
        // each office to the sections it owns.
        allow update: if isBackOffice(collegeId);
        allow delete: if isSuperadmin() || (role() == 'principal' && collegeId() == collegeId);
      }
      match /counters/{docId} {
        allow read, write: if isBackOffice(collegeId);
      }
      // Roster of office staff — written only by the manageOfficeStaff callable.
      // Accounts / operations roster — managed by the superadmin only
      // (grantUserRole + manageOfficeStaff); each member may read their row.
      match /officeStaff/{docId} {
        allow read: if isSuperadmin() || (isSignedIn() && docId == request.auth.uid);
        allow write: if false;
      }

      match /faculty/{docId} {
        allow get: if isSignedIn() && (isSuperadmin()
          || (isStaff() && deptScoped(resource.data))
          || (isOffice() && collegeId() == collegeId));
        allow list: if isSignedIn() && (isSuperadmin() || isStaff()
          || (isOffice() && collegeId() == collegeId));
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /materials/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow list: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow write: if collegePathWrite(collegeId);
      }

      match /events/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow list: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow write: if collegePathWrite(collegeId);
      }

      match /notifications/{docId} {
        allow get: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow list: if isSignedIn() && (isSuperadmin() || isStaff() || (role() == 'student' && collegeId() == collegeId));
        allow create: if isSuperadmin()
          || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId);
        // Recipients may only flip their own read flag (see
        // src/modules/student/pages/StudentNotificationsPage.tsx). Before this,
        // a student could never mark a college notification as read.
        allow update: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId)
          || (isSignedIn()
            && isRecipient(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow delete: if isSuperadmin()
          || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId);
      }

      // "Connect with mentors" (src/api/facultyAppointmentApi.ts). Neither
      // collection had a rule before this block, so the catch-all denied every
      // read AND write: faculty availability could never be saved, and no
      // appointment could be filed or answered. The identity both rows carry
      // is the auth UID — AuthContext exposes user.id === uid — so ownership
      // is provable without any profile read.
      match /facultyAvailability/{facultyId} {
        // Office hours are directory information for the college's students;
        // only the owning faculty account (or college management) writes them.
        // The facultyId==path check keeps a manager from silently writing a
        // document whose field points at a different teacher.
        allow get: if isSignedIn() && collegeId() == collegeId
          && (isCollegeStaff() || role() == 'student');
        allow list: if isSignedIn() && isCollegeStaff() && collegeId() == collegeId;
        allow create, update: if isSignedIn() && collegeId() == collegeId
          && ((facultyId == request.auth.uid
              && (role() == 'faculty' || (role() == 'employee' && isStaff())))
              || claimedRole() in ['admin', 'hod', 'principal'])
          && request.resource.data.facultyId == facultyId;
        allow delete: if isSignedIn() && collegeId() == collegeId
          && claimedRole() in ['admin', 'hod', 'principal'];
      }

      match /facultyAppointments/{appointmentId} {
        allow get, list: if isSignedIn() && collegeId() == collegeId
          && (isCollegeStaff()
              || resource.data.studentId == request.auth.uid
              || resource.data.facultyId == request.auth.uid);
        // A request is filed by the student it names, into the student's own
        // college, and always starts pending — nobody can pre-confirm
        // themselves.
        allow create: if isSignedIn() && role() == 'student' && collegeId() == collegeId
          && request.resource.data.collegeId == collegeId
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.facultyId is string
          && request.resource.data.facultyId != ''
          && request.resource.data.status == 'pending';
        // Faculty answer only the requests addressed to them and only through
        // the response fields; a student may cancel their own and nothing
        // else; college management moderates.
        allow update: if isSignedIn() && collegeId() == collegeId
          && request.resource.data.collegeId == resource.data.collegeId
          && (
            claimedRole() in ['admin', 'hod', 'principal']
            || (resource.data.facultyId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                ['status', 'facultyRemarks', 'meetingLocation', 'updatedAt']))
            || (resource.data.studentId == request.auth.uid
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                ['status', 'updatedAt']))
          );
        allow delete: if isSignedIn() && collegeId() == collegeId
          && claimedRole() in ['admin', 'hod', 'principal'];
      }
    }

    match /questions/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create: if isCollegeStaff() && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollegeStaff() && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if isSuperadmin() || (role() == 'admin' && sameCollege(resource.data));
    }

    match /papers/{id} {
      allow get: if isSignedIn() && (isSuperadmin()
        || (isStaff() && deptScoped(resource.data)));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create: if isCollegeStaff()
        && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.verificationStatus == 'draft';
      allow update: if isCollegeStaff()
        && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId
        && resource.data.status == 'draft'
        && resource.data.verificationStatus in ['draft', 'modification-requested', 'rejected-by-hod']
        && (resource.data.createdBy == request.auth.uid
          || role() in ['superadmin', 'admin', 'principal', 'hod'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'collegeId', 'createdBy', 'createdByName', 'status',
          'verificationStatus', 'submittedAt', 'publishedAt',
          'reviewedBy', 'reviewedByName', 'reviewedAt', 'approvalRemarks'
        ]);
      allow delete: if resource.data.status == 'draft'
        && (isSuperadmin() || (role() == 'admin' && sameCollege(resource.data)));
    }

    match /paperReviewAudit/{auditId} {
      allow read: if isSuperadmin()
        || (role() in ['admin', 'principal', 'hod'] && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    match /attendance/{id} {
      allow get: if ('studentId' in resource.data && ownsStudentId(resource.data.studentId))
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isStaff() && sameCollege(resource.data));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff()
        // A list is authorised per candidate document, so a query the client scopes
        // with where('studentId','==',own record) admits exactly those rows.
        || ('studentId' in resource.data && ownsStudentId(resource.data.studentId)));
      allow write: if tenantWrite(request.resource.data);
    }

    match /attendanceRecords/{id} {
      allow get: if ('studentId' in resource.data && ownsStudentId(resource.data.studentId))
        || (isStaff() && sameCollege(resource.data) && deptScoped(resource.data));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff()
        // A list is authorised per candidate document, so a query the client scopes
        // with where('studentId','==',own record) admits exactly those rows.
        || ('studentId' in resource.data && ownsStudentId(resource.data.studentId)));
      allow write: if tenantWrite(request.resource.data);
    }

    // -- Staff (faculty) attendance --------------------------------------------
    // One document per faculty member per calendar day, written by
    // src/shared/api/staffAttendanceApi.ts with the deterministic id
    // {collegeId}__{facultyUid}__{YYYY-MM-DD}.
    //
    // This is NOT student attendance. The distinguishing rule is ownership: a
    // faculty member marks their OWN day and nothing else, while the people who
    // read the whole college's records are the ones who run it. Note that
    // `isStaff()` includes faculty and mentors, so it is deliberately NOT used
    // for the college-wide read below — that would let any teacher list every
    // colleague's attendance.
    //
    // WRITE PATH: the web client writes this collection ONLY through the
    // saveMyStaffAttendance callable (functions/src/staffAttendanceWrites.ts)
    // — one unit-tested authorization decision + an Admin SDK write, immune
    // to rules drift. The create/update rules below remain as
    // defence-in-depth; the get/list rules are the LIVE read path, so do not
    // delete this block.
    match /staffAttendance/{docId} {
      function isOwnRecord(data) {
        return isSignedIn() && 'facultyId' in data && data.facultyId == request.auth.uid;
      }

      // Management roles only — the tenant still has to match the claim.
      function isAttendanceManager(data) {
        return isSignedIn() && role() in ['admin', 'principal', 'hod'] && sameCollege(data);
      }

      allow get: if isSuperadmin() || isOwnRecord(resource.data) || isAttendanceManager(resource.data);

      // A list is authorised per candidate document, so a faculty member's own
      // `where('facultyId','==',uid)` query admits exactly their own rows.
      allow list: if isSuperadmin()
        || isAttendanceManager(resource.data)
        || isOwnRecord(resource.data);

      // A faculty member writes only their own document, in their own college;
      // management may correct a record. `claimedRole()` is the verified claim,
      // so a forged role field on a profile document cannot widen this.
      allow create: if isSuperadmin()
        || (tenantWrite(request.resource.data)
          && (isOwnRecord(request.resource.data)
            || claimedRole() in ['admin', 'principal', 'hod']));

      // `facultyId` is immutable on update, for management too. Without this a
      // teacher could edit their own day and re-parent it onto a colleague's
      // uid, silently moving attendance between people — the same hole the
      // facultyTopics rules close.
      allow update: if isSuperadmin()
        || (tenantWrite(resource.data) && tenantWrite(request.resource.data)
          && 'facultyId' in resource.data
          && request.resource.data.facultyId == resource.data.facultyId
          && (isOwnRecord(resource.data) || claimedRole() in ['admin', 'principal', 'hod']));

      // Deleting a day of payroll-relevant history is a management action only.
      allow delete: if isSuperadmin()
        || (claimedRole() in ['admin', 'principal'] && sameCollege(resource.data));
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.studentId == request.auth.uid || isFinanceData(resource.data));
      allow write: if isFinanceData(request.resource.data);
    }

    // Top-level feeStructures holds one document per student (queried by
    // studentId in src/modules/student/api/studentDataApi.ts), so a student
    // reads only their own record; staff read within their own college.
    match /feeStructures/{id} {
      allow read: if isSignedIn()
        && (isFinanceData(resource.data)
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if isFinanceData(request.resource.data);
    }

    // Scheme packs (G1): universities' examination schemes. Clients only read
    // their own college's custom packs; writes go through saveSchemePack
    // (Admin SDK), which is the single door that validates slab/IA/grade
    // structure before a pack can poison result imports or hall tickets.
    match /schemePacks/{packId} {
      // Global preset packs are read-only reference data used by students and
      // staff alike; custom packs stay tenant-scoped.
      allow get, list: if isSignedIn() && (
        ('global' in resource.data && resource.data.global == true)
        || sameCollege(resource.data)
      );
      allow create, update, delete: if false;
    }

    // Academic calendar (Auto-Scheduler v2 P4): public/college holidays,
    // study holidays, fests and exam windows — the dates `generateClassSessions`
    // suppresses and the timetable screens banner as "Holiday — no classes".
    // Mirror of the schemePacks block: staff read (client-side, fast), writes
    // NEVER — saveCalendarEvent / deleteCalendarEvent (Admin SDK) are the
    // single door that validates the type enum, date order and tenancy before
    // anything can void a class session.
    match /academicCalendar/{eventId} {
      allow get, list: if isSignedIn() && isStaff() && sameCollege(resource.data);
      allow create, update, delete: if false;
    }

    match /weeklySchedules/{scheduleId} {
      // `allow get` may use resource.data (single document). `allow list` is
      // role based because a list/query request has no `resource`; the client
      // keeps its queries scoped by collegeId/facultyId.
      allow get: if isSignedIn() && (isStaff() || sameCollege(resource.data));
      // The timetable of a college is reference data for its students, not a
      // private record — which is why the collegeId claim the identity repair
      // writes has to exist: sameCollege() reads the tenant off the token.
      allow list: if isSignedIn() && (isStaff() || sameCollege(resource.data));
      allow create: if isCollegeStaff() && request.resource.data.collegeId == collegeId()
        && request.resource.data.facultyId != null
        && request.resource.data.branch != null
        && request.resource.data.batch != null
        && request.resource.data.dayOfWeek != null
        && request.resource.data.startTime != null
        && request.resource.data.endTime != null;
      allow update: if isCollegeStaff() && sameCollege(resource.data);
      allow delete: if isCollegeStaff() && sameCollege(resource.data);
    }

    match /classSessions/{sessionId} {
      allow get: if isSignedIn()
        && (isStaff() || sameCollege(resource.data))
        && deptScoped(resource.data);
      allow list: if isSignedIn() && (isStaff() || sameCollege(resource.data));
      allow create, update: if tenantWrite(request.resource.data);
      allow delete: if tenantWrite(resource.data);
    }

    match /curriculumFacultyMappings/{mappingId} {
      // Backs the admin Curriculum Management page
      // (src/modules/admin/api/curriculumMappingApi.ts) and the faculty read
      // paths (useFacultyCurriculum, sessionTopicsApi). Tenancy is the
      // collegeId stamped on the row; the owner clause keeps a legacy row
      // reachable for its teacher and is why an admin-created row whose only
      // link is facultyId still resolves. The old pair checked role only —
      // ANY signed-in staff could stream every college's mappings with an
      // unscoped collection() call, which is exactly what sessionTopicsApi
      // used to do (now scoped).
      allow get, list: if isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
        || isAssignedFaculty(resource.data);
      // Assigning curriculum is a management act (superadmin or the college's
      // admin/hod/principal). The previous isCollegeStaff() also admitted
      // faculty and mentors, so a teacher could self-assign any course in
      // their college. `delete` reads resource.data — request.resource.data
      // is null on a delete, so the old shared statement could never succeed
      // for non-superadmins (the UI soft-removes via status='removed').
      allow create, update: if isSuperadmin()
        || (role() in ['admin', 'hod', 'principal']
          && sameCollege(request.resource.data));
      allow delete: if isSuperadmin()
        || (role() in ['admin', 'hod', 'principal'] && sameCollege(resource.data));
    }

    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create: if isCollegeStaff() && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollegeStaff() && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if isSuperadmin()
        || (role() == 'admin' && sameCollege(resource.data));
    }

    match /scheduledTests/{testId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (isStaff() && sameCollege(resource.data)));
      allow write: if false;

      // The question rows carry no collegeId of their own; the parent test does.
      match /assessmentQuestions/{questionId} {
        allow read: if isSignedIn()
          && (isSuperadmin()
            || (isStaff() && scheduledTestCollegeId(testId) == collegeId()));
        allow write: if false;
      }
    }

    match /studentAssessments/{attemptId} {
      allow read: if isSignedIn()
        && (isSuperadmin()
          || (isStaff() && sameCollege(resource.data))
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if false;
    }

    // -- Resume Builder add-on -------------------------------------------------
    // resumes/{uid} holds a student's editable resume plus the PDF credit
    // ledger; resumeDownloads/{id} is one row per generated PDF (the Storage
    // object it points at is streamed by the api function, never read from the
    // browser). ALL writes go through functions/src/routes/resume.ts so the
    // credit cap (N renders per template per year) is enforced inside a
    // Firestore transaction the client cannot influence. Reads: the owner and
    // the college's academic staff (placement cell reviews).
    match /resumes/{uid} {
      allow get: if isSignedIn()
        && (request.auth.uid == uid
          || isSuperadmin()
          || (isStaff() && sameCollege(resource.data)));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if false;
    }

    match /resumeDownloads/{downloadId} {
      allow get: if isSignedIn()
        && (('uid' in resource.data && resource.data.uid == request.auth.uid)
          || isSuperadmin()
          || (isStaff() && sameCollege(resource.data)));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if false;
    }

    // Settings changes and credit resets by superadmins. Admin SDK only.
    match /resumeAudit/{entryId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    match /studentSubmissions/{submissionId} {
      allow read: if isSignedIn()
        && (isSuperadmin()
          || (isStaff() && sameCollege(resource.data))
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if false;
    }

    match /proctoringLogs/{logId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create, update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (
        isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
        || ('studentUid' in resource.data && resource.data.studentUid == request.auth.uid)
        || ('studentId' in resource.data && ownsStudentId(resource.data.studentId))
      );
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create: if false;
      allow update, delete: if false;
    }

    match /assignmentSubmissionDrafts/{draftId} {
      allow read, write: if false;
    }

    match /gradeRecords/{gradeId} {
      allow read: if (
          'studentId' in resource.data
          && ownsStudentId(resource.data.studentId)
          && resource.data.status == 'published'
        )
        || isSuperadmin()
        || (role() in ['admin', 'principal', 'hod'] && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    match /gradeRecordAudit/{auditId} {
      allow read: if isSuperadmin()
        || (role() in ['admin', 'principal', 'hod'] && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    // Audit trail. No client writes logs - Cloud Functions do (Admin SDK
    // bypasses rules), so client creates are closed to keep the trail
    // unfalsifiable.
    match /logs/{id} {
      allow read: if isSuperadmin() || (role() == 'admin' && sameCollege(resource.data));
      allow create: if false;
      allow update, delete: if isSuperadmin();
    }

    match /ai_generation_logs/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // -- Announcements ---------------------------------------------------------
    // Targeting is by cohort (batch/branch), so an announcement has no single
    // recipient: `isRecipient` can never be true for a broadcast and the old
    // per-document `read` flag was shared by the whole college. Read state now
    // lives in the `reads` subcollection below, one document per recipient.
    //
    // Students read their feed through the `getMyNotifications` callable, which
    // resolves the signed-in student's real batch/branch server-side; they need
    // no direct list permission here. Admin SDK writes from the callables
    // bypass these rules entirely, so these grants only govern browser access.
    match /notifications/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create: if isSuperadmin()
        || (isCollegeStaff() && sameCollege(request.resource.data));
      allow update: if isSuperadmin()
        || (isCollegeStaff() && sameCollege(resource.data));
      allow delete: if isSuperadmin()
        || (isCollegeStaff() && sameCollege(resource.data));

      // Per-recipient read marker written by `markMyNotificationRead`, which
      // increments `readCount` in the same transaction. Client writes are
      // refused so the counter cannot be inflated by direct document updates.
      match /reads/{readId} {
        allow get, list: if isSignedIn() && (
          isSuperadmin()
          || isStaff()
          || readId == request.auth.uid
        );
        allow write: if false;
      }
    }

    // -- Admission Center ------------------------------------------------------
    // Applicant records: enquiries, applications, entrance scores and offers,
    // all staff-entered. Every read and write goes through the `admissions`
    // callables, which resolve the caller's role and college server-side and
    // enforce the stage machine. Admin SDK writes from those callables bypass
    // these rules entirely, so browser access is refused outright: there is no
    // client path that needs it, and an applicant's personal details (date of
    // birth, guardian contact, entrance scores) should not be listable by any
    // signed-in session that happens to guess a document id.
    match /admissionApplications/{id} {
      allow read: if false;
      allow write: if false;
    }

    // -- Google Form ingest tokens ---------------------------------------------
    // The intake secret for `POST /api/admissions/ingest`. Only a hash is ever
    // stored, and only the Admin SDK may read or rotate it — a client that
    // could list this collection could hand the hash to an attacker, so there
    // is no signed-in path in either direction.
    match /admissionIngestTokens/{id} {
      allow read: if false;
      allow write: if false;
    }

    // -- Curriculum, topics, and test papers ----------------------------------
    // Read by the curriculum, topics, and dashboard flows in
    // src/modules/superadmin/api/curriculumApi.ts and
    // src/modules/faculty/api/facultyApi.ts. Writes stay with superadmin and
    // college administration; faculty may only read.

    // `list` used to be role-based (unscoped per document) while `get` was
    // tenant-scoped — the mismatch let any staff member read every college's
    // assigned curriculum with one unbounded query. canReadCurriculum() is
    // now the single definition for both.
    match /curriculum/{docId} {
      allow get, list: if canReadCurriculum(resource.data);
      allow write: if isSuperadmin()
        || (role() in ['admin', 'hod'] && sameCollege(request.resource.data));
    }

    // Same treatment for the parser's raw extracts: an extract before
    // assignment carries collegeId=null and belongs to the platform review
    // queue (superadmin only), after assignment only the owning college reads
    // it. Unassigned extracts stay hidden from staff because the field is
    // present and null, which fails sameCollege.
    match /syllabusExtracts/{docId} {
      allow get, list: if canReadCurriculum(resource.data);
      allow write: if isSuperadmin()
        || (role() in ['admin', 'hod'] && sameCollege(request.resource.data));
    }

    // Shared curriculum bank (`topics/*`) written only by superadmin. The old
    // owner clause (`facultyId == uid`) was dead: no writer ever stamped
    // facultyId on a bank row — a faculty member's own store is facultyTopics.
    match /topics/{docId} {
      allow get, list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin();
    }

    // Backs the faculty topic planner in src/hooks/useTopics.ts, which reads and
    // writes this top-level collection straight from the browser (getDocs with
    // where('facultyId','==',uid), addDoc, updateDoc, deleteDoc). It had no
    // match block at all, so the default-deny catch-all below rejected even the
    // page's first query and the Topics page failed with a permission error.
    // The hook stamps facultyId from the signed-in uid and writes no collegeId,
    // so tenancy here is ownership by uid — not sameCollege(). Faculty may list
    // (staff-only) and may only create/update/delete rows they own; update
    // additionally pins facultyId so a row cannot be handed to another faculty.
    match /facultyTopics/{docId} {
      allow get: if isSignedIn()
        && (isSuperadmin() || isStaff() || isAssignedFaculty(resource.data));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow create: if isSuperadmin()
        || (isStaff() && isAssignedFaculty(request.resource.data));
      allow update: if isSuperadmin()
        || (isStaff() && isAssignedFaculty(resource.data)
          && isAssignedFaculty(request.resource.data));
      allow delete: if isSuperadmin()
        || (isStaff() && isAssignedFaculty(resource.data));
    }

    match /testPapers/{docId} {
      allow get: if isSignedIn()
        && (isSuperadmin() || isStaff()
          || ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin();
    }

    // -- Super-admin system management ----------------------------------------
    // These collections are deliberately separate from tenant data. They back
    // the live diagnostics and operational controls page; only an authoritative
    // superadmin can read or change platform-wide settings and telemetry.
    match /systemConfig/{docId} {
      allow read, write: if isSuperadmin();
    }

    // -- Platform-access products (duration + price sold per student) ---------
    // Superadmin master data, like colleges and systemConfig. Any write that
    // touches STUDENT records (assigning a window) goes through the
    // bulkUpdateStudentAccess callable instead, because it must stay atomic
    // with users/{uid} and is college-scoped.
    match /accessProducts/{productId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff() || isOffice());
      allow create, update, delete: if isSuperadmin();
    }

    match /systemAuditLogs/{docId} {
      allow read: if isSuperadmin();
      allow create: if isSuperadmin();
      allow update, delete: if false;
    }

    // Cloud Functions may write telemetry with the Admin SDK. The console can
    // inspect it, but cannot forge or delete operational history from a browser.
    match /performanceMetrics/{docId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }
    match /slowQueries/{docId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }
    match /errors/{docId} {
      allow read: if isSuperadmin();
      allow update: if isSuperadmin();
      allow create, delete: if false;
    }
    match /alerts/{docId} {
      allow read: if isSuperadmin();
      allow update: if isSuperadmin();
      allow create, delete: if false;
    }

    // -- Attendance summaries --------------------------------------------------
    // Written inside the same atomic batch as attendance and attendanceRecords
    // (src/modules/faculty/api/facultyApi.ts markAttendance). A missing rule
    // here failed the entire batch, so attendance could never be saved.
    match /attendanceSummary/{docId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if tenantWrite(request.resource.data);
    }

    // -- Fees and library ------------------------------------------------------
    // fees is keyed by student id, so the tenant is resolved from the student
    // profile rather than from a field on the fee document itself.
    match /fees/{studentId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (role() in ['principal', 'accounts'] && studentCollegeId(studentId) == collegeId())
          || isOwner(studentId) || ownsStudentId(studentId));
      allow write: if isSuperadmin()
        || (role() in ['principal', 'accounts'] && studentCollegeId(studentId) == collegeId());
    }

    // Legacy GLOBAL catalogue (not tenant-scoped): retired in favour of
    // colleges/{id}/libraryTitles. Readable only for rows tagged with the
    // caller's college; writes superadmin-only so no college can edit
    // another's books.
    match /libraryBooks/{docId} {
      allow read: if isSignedIn() && sameCollege(resource.data);
      allow write: if isSuperadmin();
    }

    match /issuedBooks/{docId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || isStaff()
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if isSuperadmin() || isCollegeStaff();
    }

    // -- Shared cloud question bank --------------------------------------------
    // Backs src/modules/admin/api/cloudStorageApi.ts. These collections are
    // shared across colleges by design ("papers_universal"), so access is
    // role-based rather than tenant-scoped, matching the existing questions
    // and papers rules.
    match /questionBank_meta/{docId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin() || isCollegeStaff();
    }

    // Full question payload (text / options / explanation / images). Paired 1:1
    // with questionBank_meta/{docId} — read on preview/use only, never in lists.
    match /questionBank_content/{docId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin() || isCollegeStaff();
    }

    // One summary document per student, maintained by the attendanceSummary
    // Cloud Functions (item 3.1: replaces the up-to-500-row read every student
    // dashboard used to do). A student may read their OWN summary; college staff
    // read their college's; nobody writes from a client — the totals must be
    // server-computed or the percentage could be forged.
    match /attendanceSummaries/{studentId} {
      allow get: if isSignedIn() && (isSuperadmin()
        || (isCollegeStaff() && sameCollege(resource.data))
        || ownsStudentId(studentId));
      allow list: if isSignedIn() && (isSuperadmin() || isCollegeStaff());
      allow write: if false;
    }

    // Platform-level documents written only by Cloud Functions with the Admin
    // SDK: `stats` (refreshPlatformStats, every 15 min — the superadmin
    // dashboard's source, see item 2.4) and `aiModelCanary` (daily model
    // liveness probe, item 2.1). Superadmins may READ them; nobody may write
    // from a client, so a counter can never be forged.
    match /platform/{docId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    // Vriddhi platform employee assignments (colleges + academic grants).
    // Written ONLY by the employeeAccess callables with the Admin SDK, because
    // this document is what decides which colleges an employee may work in.
    // An employee may read their own assignment; nobody may write it from a
    // client, so a compromised session cannot widen its own scope.
    match /platform_employees/{uid} {
      allow get: if isSignedIn() && (isSuperadmin() || request.auth.uid == uid);
      allow list: if isSuperadmin();
      allow write: if false;
    }

    // Generated-content cache (item 4.1). `aiContentCache/{sha256(kind|key|
    // model|promptVersion)}` holds study/prep/question output that came from a
    // model. Only Cloud Functions touch it: the key can address content for any
    // syllabus, so a client that could read the collection could enumerate the
    // platform's whole draft library, and a client that could write it could
    // poison what other colleges are served.
    match /aiContentCache/{docId} {
      allow read, write: if false;
    }

    // Daily AI-chat turn counters (item D2 of the optimisation hand-off).
    // `ai_chat_quota/{uid}_{YYYY-MM-DD}` is written ONLY by the /ai/chat route
    // with the Admin SDK, which checks the counter before doing any work and
    // increments it after a reply is produced. Clients are denied outright:
    // a student must not be able to reset their own cap, and nobody may read
    // another student's usage.
    match /ai_chat_quota/{docId} {
      allow read, write: if false;
    }

    // Import job bookkeeping for the Superadmin "Import papers (ZIP)" flow.
    // Every read and write goes through the api function's
    // /question-import/jobs routes, which run with the Admin SDK and enforce
    // requireRole('superadmin') plus a per-uid rate limit; the panel never
    // touches this collection directly. Clients are denied outright rather than
    // scoped, so a compromised superadmin session cannot forge job counters or
    // edit another operator's progress. Drafts the worker produces land in
    // questionBank_meta above and are read from there.
    match /questionBankImportJobs/{docId} {
      allow read, write: if false;
    }

    match /papers_universal/{docId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin() || isCollegeStaff();
    }

    match /paperTemplates/{docId} {
      allow read: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin() || isCollegeStaff();
    }

    match /questionReviews/{docId} {
      allow get: if isSignedIn() && (isSuperadmin()
        || (isStaff() && deptScoped(resource.data)));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if isSuperadmin() || isCollegeStaff();
    }

    // Written by Cloud Functions only; the admin UI reads it through
    // src/modules/admin/api/assessmentsApi.ts.
    match /reviewQueue/{docId} {
      allow get: if isSignedIn() && (isSuperadmin()
        || (isStaff() && deptScoped(resource.data)));
      allow list: if isSignedIn() && (isSuperadmin() || isStaff());
      allow write: if false;
    }

    // Server-only collections (no match block => fall through to the
    // catch-all deny below). Admin SDK only:
    //   - ai_study_materials: versioned AI study packs + per-campus pins
    //   - ai_config/{collegeId}: per-campus AI cost controls (daily caps,
    //     exam freeze windows) managed via the api function's
    //     /ai/study-material/controls endpoints
    //   - ai_usage/{YYYY-MM-DD}: real-time spend telemetry (serves,
    //     generations, tokens; per-campus and per-student counters)

    // -- Global Prep Content (B2C & VAS Study Material) -----------------------
    // Centrally-authored academic preparation content for UG/PG commerce & management.
    // Any signed-in user (including B2C learners who hold no collegeId claim)
    // may read published prep content. Superadmins may read drafts/review content.
    // All writes are server-only through the Admin SDK.
    match /prep_subjects/{subjectId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isSuperadmin());
      allow write: if false;

      match /topics/{topicId} {
        allow read: if isSignedIn() && (resource.data.status == 'published' || isSuperadmin());
        allow write: if false;
      }
    }

    // Previous-year university question papers (structured text, English).
    // Same boundary as prep_subjects: signed-in readers see published papers,
    // superadmins also see drafts, and every write goes through the Admin SDK
    // (POST /prep/papers, /prep/seed-all).
    match /prep_papers/{paperId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isSuperadmin());
      allow write: if false;
    }

    // Model answers for those papers (item 3.4) and the quick-revision MCQ sets
    // built from them (item 3.5). Same published/subject boundary as the papers
    // they belong to, with one addition: a REJECTED answer is not readable even
    // by a superadmin from a client, because the reviewer's queue goes through
    // GET /prep/papers/answers (Admin SDK). Writes are server-only — publishing
    // is the human gate the "AI-generated, reviewed" label promises, so a client
    // must never be able to flip the status field itself.
    match /prep_paper_answers/{answerId} {
      allow read: if isSignedIn() && ((resource.data.status == 'published' && resource.data.rejected != true) || isSuperadmin());
      allow write: if false;
    }

    match /prep_mcq_sets/{setId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isSuperadmin());
      allow write: if false;
    }

    // Individual learner topic and quiz completion progress.
    // Owner-only read and write.
    match /prep_progress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Shared universal question bank linked to prep topics via prepTags.topicIds.
    // Any signed-in user may read approved questions for practice.
    // Writes are managed centrally by superadmin or Admin SDK.
    match /universalQuestions/{qid} {
      allow read: if isSignedIn() && (resource.data.status == 'approved' || isSuperadmin());
      allow write: if isSuperadmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
