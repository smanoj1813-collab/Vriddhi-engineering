rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // -- Identity resolution ---------------------------------------------------
    // Role and college are AUTHORITATIVE from the verified ID-token custom
    // claim ONLY — exactly like the Firestore rules. The old profile-based
    // resolution (role/college read from users/{uid}, faculty, students, admins,
    // hods, mentors) is deliberately gone: those documents are client-writable,
    // so trusting them here lets an account that can create a document forge a
    // role or cross college boundaries. A newly provisioned or repaired account
    // must therefore have its claims issued AND the user must sign in again —
    // an ID token only carries claims that existed when it was minted.

    function claimRole() {
      return isSignedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function claimCollege() {
      return isSignedIn() && 'collegeId' in request.auth.token
        ? request.auth.token.collegeId
        : null;
    }

    // -- Role normalisation ---------------------------------------------------
    // The same role is spelled many ways across the generations of imports this
    // database has absorbed ("Faculty", "teacher", "Head of Department", ...),
    // so every comparison canonicalises first.

    function cleanRoleValue(raw) {
      return raw is string ? raw.trim().lower() : '';
    }

    function canonicalRole(value) {
      return value == 'teacher' || value == 'teaching staff' || value == 'teaching-staff'
        || value == 'teaching_staff' || value == 'lecturer' || value == 'professor'
        || value == 'assistant professor' || value == 'associate professor'
        || value == 'instructor' || value == 'faculty member' || value == 'faculty-member'
        ? 'faculty'
        : value == 'head of department' || value == 'head-of-department'
          || value == 'head_of_department' || value == 'dept head' || value == 'department head'
          ? 'hod'
        : value == 'administrator' || value == 'admin staff' || value == 'college admin'
          ? 'admin'
        : value == 'super admin' || value == 'super-admin' || value == 'super_admin'
          || value == 'superuser' || value == 'owner'
          ? 'superadmin'
        : value == 'vice principal' || value == 'vice-principal' || value == 'vice_principal'
          ? 'principal'
        : value == 'learner' || value == 'pupil'
          ? 'student'
        : value == 'guardian'
          ? 'parent'
        : value;
    }

    // AUTHORITATIVE IDENTITY. Role for authorization decisions is taken from the
    // verified ID-token custom claim ONLY — never from a client-writable profile
    // document.
    function role() {
      let claimedRole = canonicalRole(cleanRoleValue(claimRole()));
      return claimedRole != '' ? claimedRole : null;
    }

    // Tenancy, like role, is authoritative from the claim only.
    function tenantCollege() {
      let claimedCollege = claimCollege();
      return claimedCollege != null ? claimedCollege : null;
    }

    // A superadmin is proven by the superadmin custom claim, or by a
    // superadmins/{uid} document — which itself is writable solely by an
    // already-authoritative superadmin. It is never inferred from a
    // faculty/student/admin/etc. profile doc.
    function isSuperadmin() {
      return isSignedIn()
        && (canonicalRole(cleanRoleValue(claimRole())) == 'superadmin'
          || firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid)));
    }

    function isStaff() {
      return isSignedIn()
        && role() in ['superadmin', 'admin', 'principal', 'hod', 'faculty', 'mentor'];
    }

    function isPaperManager() {
      return isSignedIn() && role() in ['superadmin', 'admin', 'principal', 'hod'];
    }

    // Which student document this account vouches for, read from the users/{uid}
    // pointer that the identity repair writes. Read through an exists() guard so
    // a missing pointer document falls through to the per-row checks below
    // instead of raising a hard deny.
    function myStudentDocId() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && 'studentDocId' in firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)).data
        ? firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)).data.studentDocId
        : null;
    }

    function ownsStudentId(studentId) {
      return isSignedIn()
        && studentId != null
        && (
          studentId == request.auth.uid
          || myStudentDocId() == studentId
          || (firestore.exists(/databases/(default)/documents/students/$(studentId))
            && (('userId' in firestore.get(
                  /databases/(default)/documents/students/$(studentId)).data
                && firestore.get(
                  /databases/(default)/documents/students/$(studentId)).data.userId
                  == request.auth.uid)
              || ('uid' in firestore.get(
                    /databases/(default)/documents/students/$(studentId)).data
                && firestore.get(
                  /databases/(default)/documents/students/$(studentId)).data.uid
                  == request.auth.uid)))
        );
    }

    function managesAssignment(assignmentId) {
      return isStaff()
        && firestore.exists(/databases/(default)/documents/assignments/$(assignmentId))
        && (
          isSuperadmin()
          || (
            role() in ['admin', 'principal', 'hod', 'faculty']
            && tenantCollege() != null
            && 'collegeId' in firestore.get(
                /databases/(default)/documents/assignments/$(assignmentId)).data
            && firestore.get(
                /databases/(default)/documents/assignments/$(assignmentId)).data.collegeId
                == tenantCollege()
            && (role() != 'faculty'
              || ('facultyUid' in firestore.get(
                    /databases/(default)/documents/assignments/$(assignmentId)).data
                && firestore.get(
                    /databases/(default)/documents/assignments/$(assignmentId)).data.facultyUid
                    == request.auth.uid))
          )
        );
    }

    function validAssignmentFile() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|text/plain|image/.*'
        );
    }

    function validPaperFile() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|image/jpeg|image/png'
        );
    }

    function validSubmissionSession(studentId, assignmentId, sessionId) {
      // Document reads are cached per request, so the repeated lookups below
      // cost one read. The exists() guard keeps a missing draft from raising
      // an error instead of a plain deny.
      return firestore.exists(
        /databases/(default)/documents/assignmentSubmissionDrafts/$(sessionId)
      )
        && ownsStudentId(studentId)
        && firestore.get(
          /databases/(default)/documents/assignmentSubmissionDrafts/$(sessionId)
        ).data.studentUid == request.auth.uid
        && firestore.get(
          /databases/(default)/documents/assignmentSubmissionDrafts/$(sessionId)
        ).data.studentId == studentId
        && firestore.get(
          /databases/(default)/documents/assignmentSubmissionDrafts/$(sessionId)
        ).data.assignmentId == assignmentId
        && firestore.get(
          /databases/(default)/documents/assignmentSubmissionDrafts/$(sessionId)
        ).data.status == 'uploading'
        && firestore.get(
          /databases/(default)/documents/assignmentSubmissionDrafts/$(sessionId)
        ).data.expiresAt > request.time;
    }

    // A server-created, expiring upload session authorizes each object. This
    // makes abandoned uploads discoverable and cleanable instead of creating
    // permanent orphan objects before a submission record exists.
    match /assignment-submissions/{studentId}/{assignmentId}/{sessionId}/{fileName} {
      allow read: if ownsStudentId(studentId) || managesAssignment(assignmentId);
      allow create, update: if validSubmissionSession(studentId, assignmentId, sessionId)
        && validAssignmentFile();
      allow delete: if ownsStudentId(studentId) || managesAssignment(assignmentId);
    }

    // Paper objects are namespaced by tenant, author and pre-generated paper
    // ID. The callable verifies the object before referencing it in Firestore.
    match /paper-files/{collegeId}/{ownerUid}/{paperId}/{fileName} {
      allow read: if isStaff()
        && (isSuperadmin() || tenantCollege() == collegeId);
      allow create, update: if isStaff()
        && request.auth.uid == ownerUid
        && (isSuperadmin() || tenantCollege() == collegeId)
        && validPaperFile();
      allow delete: if isStaff()
        && (request.auth.uid == ownerUid || isPaperManager())
        && (isSuperadmin() || tenantCollege() == collegeId);
    }

    // Question-bank figures — the diagrams a logical-reasoning, quantitative
    // or science question needs. Written by college staff while authoring a
    // question (the submission form uploads through
    // src/modules/admin/api/questionImageUpload.ts) and read by the SAME
    // college's students while a test is on screen: the object the staff
    // member uploaded is the object the student's browser loads mid-test.
    //
    // The college segment is the tenant boundary. Platform-curated questions
    // (superadmin-authored) use the literal segment `platform`, which every
    // signed-in user may read, matching their `visibility: public` metadata.
    // The 2 MB / image-MIME caps mirror QUESTION_IMAGE_MAX_BYTES and
    // questionImageExtension in src/shared/utils/questionImage.ts — raise both
    // together or the form and the rules will disagree.
    match /images/questions/{collegeId}/{subjectId}/{topicId}/{questionId}/{fileName} {
      allow read: if isSignedIn()
        && (isSuperadmin() || collegeId == 'platform' || tenantCollege() == collegeId);
      allow create, update: if isStaff()
        && (isSuperadmin() || tenantCollege() == collegeId)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/png|image/jpeg|image/webp');
      allow delete: if isStaff()
        && (isSuperadmin() || tenantCollege() == collegeId);
    }

    // Prep content diagrams / visual explanations. The /prep public pages are
    // unauthenticated, so these objects are PUBLIC read. Writes come only from
    // the superadmin Prep Studio "Upload image" control (superadmin-gated in
    // the UI AND here), with an image MIME + 4 MB cap.
    match /prep-media/{fileName} {
      allow read: if true;
      allow create, update: if isSuperadmin()
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/png|image/jpeg|image/webp|image/gif');
      allow delete: if isSuperadmin();
    }

    // Bulk question-paper import (previous-year papers → question-bank drafts).
    //
    // The superadmin uploads ONE zip (or a single document) here; the
    // `api` function's import worker unpacks it into `.../files/` and reads the
    // bytes through the Admin SDK, so no read grant is needed for the browser
    // beyond the operator being able to see their own upload. The path binds the
    // object to the uploader's uid AND to the server-issued job id, so one
    // superadmin can never write into another's job folder, and the 80 MB /
    // document-MIME caps match IMPORT_MAX_ARCHIVE_BYTES in
    // functions/src/questionImport.ts.
    match /question-paper-imports/{uid}/{jobId}/{fileName} {
      allow read: if isSuperadmin();
      allow create, update: if isSuperadmin()
        && request.auth.uid == uid
        && request.resource.size <= 80 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'application/pdf|application/zip|application/x-zip-compressed|application/msword|application/vnd\\\\.openxmlformats-officedocument\\\\.wordprocessingml\\\\.document|image/jpeg|image/png'
        );
      allow delete: if isSuperadmin();
    }

    // Resume Builder PDFs: resumes/{collegeId}/{uid}/{downloadId}.pdf
    // Written by the api function after a credit is reserved and streamed back
    // through GET /resume/downloads/:id/file (owner or college staff, checked
    // against the resumeDownloads row). Nothing touches these from the browser.
    match /resumes/{collegeId}/{uid}/{fileName} {
      allow read, write: if false;
    }

    // Faculty teaching materials: colleges/{collegeId}/materials/{fileName}
    // (filename may contain subfolders from the upload UI's sanitised names).
    //
    // HISTORY: this path contract was missing from the claims-only rewrite, so
    // the client's Storage upload was DENIED for every faculty upload and the
    // code silently fell back to embedding the whole file as a base64 data URL
    // inside the Firestore material doc — 7x the per-GB cost of Storage AND
    // capped at Firestore's 1 MiB doc limit (any file over ~700 KB failed to
    // save at all). This block restores the intended contract: real files in
    // cheap Storage, staff-write only, 50 MB cap.
    match /colleges/{collegeId}/materials/{fileName=**} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (tenantCollege() == collegeId && (isStaff() || role() == 'student')));
      allow create, update: if isStaff()
        && tenantCollege() == collegeId
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|application/vnd\\.ms-powerpoint|application/vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation|image/.*|video/mp4|video/quicktime|video/webm'
        );
      allow delete: if isSuperadmin()
        || (isStaff() && tenantCollege() == collegeId);
    }

    // Fee payment-proof screenshots (Record Payment / student-submitted proof).
    // Tenant-scoped like every other college path: staff of the college record
    // proofs, and the owning student may attach their own; images only, 5 MB cap
    // (mirrors src/modules/admin/utils/feeProof.ts).
    match /colleges/{collegeId}/fee-proofs/{paymentId}/{fileName} {
      function proofStudentId() {
        return firestore.exists(/databases/(default)/documents/colleges/$(collegeId)/feePayments/$(paymentId))
          ? firestore.get(/databases/(default)/documents/colleges/$(collegeId)/feePayments/$(paymentId)).data.studentId
          : null;
      }
      function canAccessProof() {
        return isSignedIn()
          && (
            isSuperadmin()
            || (tenantCollege() == collegeId && isStaff())
            || ownsStudentId(proofStudentId())
          );
      }
      allow read: if canAccessProof();
      allow create, update: if canAccessProof()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSuperadmin()
        || (isStaff() && tenantCollege() == collegeId);
    }

    // College branding: logo and campus/cover image. Everyone in the college
    // (students included — digital ID cards show the logo) may read; the
    // principal / admin (or superadmin) may upload. Images only, 3 MB cap.
    match /colleges/{collegeId}/branding/{fileName} {
      allow read: if isSignedIn() && (isSuperadmin() || tenantCollege() == collegeId);
      allow create, update, delete: if isSignedIn()
        && (isSuperadmin() || (tenantCollege() == collegeId && role() in ['principal', 'admin']))
        && (request.resource == null || (
          request.resource.size <= 3 * 1024 * 1024
          && request.resource.contentType != null
          && request.resource.contentType.matches('image/.*')));
    }

    // No implicit authenticated-user access. Additional product workflows
    // receive explicit path contracts as they are implemented.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
