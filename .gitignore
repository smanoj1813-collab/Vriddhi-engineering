# dependencies
node_modules/

# environment variables
.env
.env.local
.env.*.local

# build output
dist/
build/
coverage/
*.tsbuildinfo

# Cloud Functions build output (tsc emits to functions/lib)
functions/lib/

# Stale compiled leftovers must not be re-committed (source is TypeScript only)
functions/src/**/*.js
functions/src/**/*.js.map

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
# Firestore emulator writes this into the project root on every run.
firestore-debug.log*

# editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Firebase
.firebase/
functions/.env
functions/.env.*

# Service-account keys. These are full project-admin credentials: anyone
# holding one can mint custom claims, read every Firestore document and
# impersonate any user. They are downloaded for local repair scripts only and
# must never be committed. Generating an extra key is additive, so there is no
# reason to keep one in the tree.
*firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json
# .firebaserc is intentionally TRACKED: it pins the Google Cloud project that
# the rules, functions and hosting in this repository belong to. Leaving it out
# is what let deploys drift (a deploy without --project either fails or targets
# whatever project the CLI remembered last), and the identity bug was partly a
# deployment problem. It contains no secrets — only the project id.
# .firebaserc

# Project artifacts / scratch
artifacts/
*.BACKUP
assessment_files_dump.txt

# Faculty answer-key HTML (generated locally with --with-key; student previews are tracked)
content/pre-assessment/previews/*-key.html
# marketing build byproducts
marketing/__pycache__/

# python bytecode
__pycache__/
*.pyc
database-debug.log*

serviceAccountKey.json

# Isolated tooling installed by the scheme CI job (tsx loader only)
.ci-tools/
